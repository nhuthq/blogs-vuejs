{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strict": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src","env.d.ts"]
}